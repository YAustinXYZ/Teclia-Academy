PORT=3001
NODE_ENV=development

# Supabase Postgres connection string (required)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

JWT_SECRET=replace_with_a_secure_random_value

# true = save uploads to Backend/uploads (recommended for local)
# false = Supabase Storage (required on Vercel)
LOCAL_UPLOADS=true

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=uploads
# Increase the uploads bucket file-size limit in Supabase to allow your video sizes.

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
